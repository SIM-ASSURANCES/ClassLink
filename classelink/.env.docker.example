# ═══════════════════════════════════════════════════════════════════════════
# Configuration de production pour le déploiement Docker (docker-compose.yml)
#
# 1. Copier ce fichier en ".env" (même dossier que docker-compose.yml) :
#      cp .env.docker.example .env
# 2. Remplir toutes les valeurs ci-dessous.
# 3. Ne jamais commit le fichier ".env" réel (il est dans .gitignore).
# ═══════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL (conteneur "db") ─────────────────────────────────────────────
# Généré avec : openssl rand -base64 24
POSTGRES_PASSWORD=""

# ─── Auth.js (Next-Auth v5) ───────────────────────────────────────────────────
# Généré avec : openssl rand -base64 32
AUTH_SECRET=""
# Obligatoire derrière un reverse proxy (Caddy) pour qu'Auth.js fasse confiance
# aux en-têtes X-Forwarded-Host / X-Forwarded-Proto.
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://myclasslink.cloud"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── JWT mobile (app Flutter) ────────────────────────────────────────────────
# Optionnel — si vide, l'app retombe sur AUTH_SECRET (voir lib/auth/mobile-jwt.ts).
MOBILE_JWT_SECRET=""

# ─── Email — Resend ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="MyClassLink"

# ─── SMS — AfricasTalking ─────────────────────────────────────────────────────
AT_API_KEY=""
AT_USERNAME=""
AT_SHORTCODE=""

# ─── Stockage — Cloudflare R2 ────────────────────────────────────────────────
# Nécessaire pour les photos élèves, documents, bulletins PDF, etc.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ─── Redis — Upstash ─────────────────────────────────────────────────────────
# Optionnel : sans ces valeurs, le rate-limiting retombe automatiquement sur
# une limite en mémoire locale (lib/rate-limit.ts) — fonctionne mais ne se
# partage pas entre plusieurs instances de l'app.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Paiements — GeniusPay (https://pay.genius.ci/docs/api) ──────────────────
GENIUSPAY_API_KEY=""
GENIUSPAY_API_SECRET=""
GENIUSPAY_WEBHOOK_SECRET=""

# ─── IA — OpenRouter (https://openrouter.ai) ─────────────────────────────────
OPENROUTER_API_KEY=""

# ─── Firebase Admin (notifications push mobiles) ─────────────────────────────
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ─── Monitoring — Sentry ─────────────────────────────────────────────────────
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://myclasslink.cloud"
NEXT_PUBLIC_APP_NAME="MyClassLink"
NEXT_PUBLIC_APP_DOMAIN="myclasslink.cloud"

# ─── Compte Super Admin (créé par `docker compose run --rm seed`) ────────────
SUPER_ADMIN_EMAIL="admin@myclasslink.cloud"
SUPER_ADMIN_PASSWORD=""
